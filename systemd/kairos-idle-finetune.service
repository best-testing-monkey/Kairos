[Unit]
Description=Kairos idle-GPU fine-tuning runner
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/media/baz/MonkeyWorks/PycharmProjects/Kairos
ExecStart=/home/baz/.local/bin/uv run scripts/kairos_idle_finetune.py
EnvironmentFile=-%h/.config/kairos/kairos.env

# Do not restart: the runner decides whether to skip or run each time.
Restart=no

[Install]
WantedBy=default.target

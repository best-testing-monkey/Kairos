# Kairos automation secrets
#
# Copy this file to ~/.config/kairos/kairos.env and fill in real values.
# It is read by the systemd services (kairos-daily-signals.service,
# kairos-weekly-discovery.service) and by the scripts when run manually.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram chat ID to receive alerts. Can be a user ID or a channel like @mychannel.
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional: allow the GPU recovery ladder to reboot the machine for unattended
# long runs. Set to 1 only if you are okay with automatic reboots.
# KAIROS_GPU_ALLOW_REBOOT=0
